<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/arContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Debug overlay with compass arrow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#AA000000"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/debugOverlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="Initializing..."
            android:textColor="#00FF00"
            android:textSize="12sp" />

        <com.example.fixedearthanchordemo.CompassArrowView
            android:id="@+id/compassArrow"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="8dp" />

    </LinearLayout>

    <!-- Two placement buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="50dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/placeFixedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:padding="16dp"
            android:text="Place at Fixed"
            android:textSize="12sp" />

        <Button
            android:id="@+id/placeHereButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Place Where Pointing"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>